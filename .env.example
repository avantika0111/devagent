# DevAgent environment variables
# Copy to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# ---------------------------------------------------------------------------
# Primary — NVIDIA NIM
# Get your key at: build.nvidia.com → top right → Get API Key
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-...

# ---------------------------------------------------------------------------
# Fallback — Gemini free tier
# Get your key at: aistudio.google.com → Get API Key (no credit card needed)
# Free limits: 10 RPM, 250 requests/day
# ---------------------------------------------------------------------------
GEMINI_API_KEY=AIza...

# ---------------------------------------------------------------------------
# GitHub — required for all git operations
# Create at: github.com/settings/tokens
# Scopes needed: repo, webhook
# ---------------------------------------------------------------------------
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your-random-string-here

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# DEVAGENT_LOG_LEVEL=INFO       # DEBUG | INFO | WARNING | ERROR
# OLLAMA_BASE_URL=http://localhost:11434/v1   # if using Ollama as extra fallback
