# DevAgent environment variables
# Copy to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# ---------------------------------------------------------------------------
# Primary model provider — NVIDIA NIM
# Get your key at: build.nvidia.com → top right → Get API Key
# Free credits included. No credit card required initially.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-...

# ---------------------------------------------------------------------------
# Fallback model provider — Google Gemini (free tier)
# Get your key at: aistudio.google.com → Get API Key
# Free tier: 10 RPM, 250 requests/day. No credit card needed.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=AIza...

# ---------------------------------------------------------------------------
# GitHub — required for all git operations
# Get at: github.com/settings/tokens
# Required scopes: repo, workflow
# ---------------------------------------------------------------------------
GITHUB_TOKEN=ghp_...

# ---------------------------------------------------------------------------
# Webhook secret — required for production
# Generate any random string, e.g:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Set the same value in GitHub repo Settings → Webhooks → Secret
# ---------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=your-random-secret-here

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# DEVAGENT_LOG_LEVEL=INFO     # DEBUG | INFO | WARNING | ERROR
# DEVAGENT_PORT=8080
